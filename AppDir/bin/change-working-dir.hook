#!/bin/sh
# Auto-point OpenLoco at the original Locomotion game files.
# Looks in the portable data dir (or a standalone install) for g1.DAT.
for cand in \
    "${HOME}/.local/share/OpenLoco"; do
    if [ -f "$cand/Data/g1.DAT" ]; then
        export OPENLOCO_LOCO_PATH="$cand"
        break
    fi
done

if [ -n "${OPENLOCO_LOCO_PATH:-}" ]; then
    exec "$APPDIR/bin/OpenLoco" --locomotion_path "$OPENLOCO_LOCO_PATH" "$@"
fi
